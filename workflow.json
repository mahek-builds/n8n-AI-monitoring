    {
      "parameters": {
        "jsCode": "const cfg = $('Stamp Start').item.json;\nconst r = $input.item.json;\nconst get = (o, p) => (p ? p.split('.').reduce((a, k) => (a == null ? undefined : a[k]), o) : undefined);\n\nconst out = {\n  run_id: cfg.run_id, timestamp: cfg.timestamp, project: cfg.project,\n  endpoint_label: cfg.endpoint_label, http_status: '', latency_ms: '',\n  validation_status: 'FAIL', error_summary: '',\n  input_tokens: '', output_tokens: '', total_tokens: '', model: '',\n  estimated_cost: '', notes: '', attempt: cfg.attempt || 0, transient: false\n};\n\nif (!cfg.configured) {\n  out.validation_status = 'NOT_CONFIGURED';\n  out.notes = cfg.blocker || 'Endpoint not configured';\n  return { json: out };\n}\n\nout.latency_ms = Date.now() - cfg.started_at;\n\nif (r.error) {\n  out.http_status = 0;\n  out.transient = true;\n  out.error_summary = String(r.error.message || r.error).slice(0, 200);\n  return { json: out };\n}\n\nout.http_status = r.statusCode;\nlet body = r.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) {} }\n\nif (r.statusCode < 200 || r.statusCode >= 300) {\n  out.transient = [502, 503, 504].includes(r.statusCode);\n  out.error_summary = ('HTTP ' + r.statusCode + ' ' + JSON.stringify(body)).slice(0, 200);\n  return { json: out };\n}\n\nconst answer = cfg.answer_path ? get(body, cfg.answer_path) : body;\nif (typeof answer !== 'string' || answer.trim().length < (cfg.min_answer_len || 1)) {\n  out.error_summary = 'HTTP 200 but ' + cfg.answer_path + ' missing or empty';\n  return { json: out };\n}\nif (cfg.must_contain && !answer.toLowerCase().includes(cfg.must_contain.toLowerCase())) {\n  out.error_summary = 'Expected keyword not found in answer';\n  return { json: out };\n}\n\nconst notes = [];\nif (cfg.citations_path) {\n  const c = get(body, cfg.citations_path);\n  const has = Array.isArray(c) ? c.length > 0 : !!c;\n  if (!has && cfg.citations_required) { out.error_summary = 'Citation field empty'; return { json: out }; }\n  notes.push(has ? 'citation field present (presence only, not accuracy)' : 'citation field empty');\n}\nif (cfg.sources_path) {\n  const s = get(body, cfg.sources_path);\n  const has = Array.isArray(s) ? s.length > 0 : !!s;\n  notes.push(has ? 'source metadata present' : 'source metadata absent');\n}\n\nconst u = cfg.usage || {};\nconst pick = (p) => { const v = get(body, p); return v === undefined || v === null ? '' : v; };\nout.input_tokens = pick(u.input);\nout.output_tokens = pick(u.output);\nout.total_tokens = pick(u.total);\nout.model = pick(u.model);\nif (out.total_tokens === '' && out.input_tokens !== '' && out.output_tokens !== '') {\n  out.total_tokens = Number(out.input_tokens) + Number(out.output_tokens);\n}\nif (out.total_tokens === '') notes.push('token usage unavailable');\n\nout.validation_status = 'PASS';\nout.notes = notes.join('; ');\nreturn { json: out };"
      },
