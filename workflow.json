      "parameters": {
        "jsCode": "const run_id = 'run_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 6);\nconst timestamp = new Date().toISOString();\nreturn [{ json: {\n  run_id, timestamp,\n  project: 'LexAgent', endpoint_label: 'POST /research', configured: true, blocker: '',\n  method: 'POST', url: 'http://host.docker.internal:8000/research',\n  body: { session_id: 'n8n-smoke', question: 'Define breach of contract in one short paragraph.', document_ids: [] },\n  timeout_ms: 90000, answer_path: 'answer.summary', min_answer_len: 40, must_contain: 'contract',\n  citations_path: 'answer.sources', citations_required: false, sources_path: '',\n  usage: { input: '', output: '', total: '', model: '' }\n} }];"
      },
